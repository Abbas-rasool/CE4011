<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:FrameAnalysis.UI.Core.Documents;assembly=FrameAnalysis.UI.Core"
                    xmlns:elem="clr-namespace:FrameAnalysisProgram.STRUCTURAL_MODEL.Elements;assembly=FrameAnalysisProgram"
                    xmlns:loads="clr-namespace:FrameAnalysisProgram.STRUCTURAL_MODEL.Loads;assembly=FrameAnalysisProgram"
                    xmlns:sl="clr-namespace:StructuralLoads;assembly=StructuralLoads"
                    xmlns:des="clr-namespace:MemberDesigner.Designers;assembly=MemberDesigner"
                    xmlns:conv="clr-namespace:FrameAnalysis.UI.Converters"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Shared resources used by the sheet templates below. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:DesignStatusToBrushConverter x:Key="StatusToBrush"/>
    <conv:CodeVisibilityConverter x:Key="CodeVis"/>
    <conv:InverseBooleanConverter x:Key="InverseBool"/>

    <!-- Material design-value cells: editable only when the row's Override is ticked.
         The edit style locks the TextBox; the display style greys catalog-driven values. -->
    <Style x:Key="OverrideValueEditStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="{Binding ManualOverride, Converter={StaticResource InverseBool}}"/>
    </Style>
    <Style x:Key="OverrideValueDisplayStyle" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ManualOverride}" Value="False">
                <Setter Property="Foreground" Value="#888888"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Design enum value sources (nested in the static Enums class → Enums+eName). -->
    <ObjectDataProvider x:Key="TimberCodes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="des:Enums+eTimberCode"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StrengthClasses" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="des:Enums+eStrengthClass"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="SpeciesGrades" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="des:Enums+eNdsSpeciesGrade"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="ServiceClasses" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="des:Enums+eServiceClass"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="MoistureConditions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="des:Enums+eMoistureContentCondition"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="LoadDurationClasses" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="des:Enums+eLoadDurationClass"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="SupportTypesEU" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="des:Enums+eSupportTypeEU"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <ObjectDataProvider x:Key="ElementKinds" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="core:ElementKind"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <ObjectDataProvider x:Key="MomentReleases" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="elem:MomentRelease"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <ObjectDataProvider x:Key="LoadDirections" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="loads:LoadDirection"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <ObjectDataProvider x:Key="LoadNatures" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="sl:eLoadNature"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <!-- Each template is one sheet. The ContentControl host's Content is the MainViewModel,
         so every template's DataContext is the view-model and binds to it directly. -->

    <DataTemplate x:Key="NodesSheetTemplate">
        <GroupBox Header="Nodes">
            <DataGrid ItemsSource="{Binding Document.Nodes}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="40"/>
                    <DataGridTextColumn Header="X [m]" Binding="{Binding X}" Width="*"/>
                    <DataGridTextColumn Header="Y [m]" Binding="{Binding Y}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="ElementsSheetTemplate">
        <GroupBox Header="Elements">
            <DataGrid ItemsSource="{Binding Document.Elements}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="36"/>
                    <DataGridTemplateColumn Header="Start" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Nodes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding StartNode, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="End" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Nodes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding EndNode, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Material" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Materials, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Section" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Sections, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Section, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Type" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource ElementKinds}}"
                                          SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Release" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource MomentReleases}}"
                                          SelectedItem="{Binding Release, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="MaterialsSheetTemplate">
        <GroupBox Header="Materials (design values auto-fill from the grade; tick Override to edit by hand)">
            <DataGrid ItemsSource="{Binding Document.Materials}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Resources>
                    <conv:BindingProxy x:Key="MatProxy" Data="{Binding}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="36"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                    <DataGridTemplateColumn Header="Material" Width="120"
                        Visibility="{Binding Data.Document.Design.Code, Source={StaticResource MatProxy}, Converter={StaticResource CodeVis}, ConverterParameter='EC5,TR'}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static core:DesignOptions.MaterialTypes}"
                                          SelectedItem="{Binding MaterialType, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Class (EC5/TR)" Width="110"
                        Visibility="{Binding Data.Document.Design.Code, Source={StaticResource MatProxy}, Converter={StaticResource CodeVis}, ConverterParameter='EC5,TR'}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource StrengthClasses}}"
                                          SelectedItem="{Binding StrengthClass, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Grade (US)" Width="150"
                        Visibility="{Binding Data.Document.Design.Code, Source={StaticResource MatProxy}, Converter={StaticResource CodeVis}, ConverterParameter=US}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource SpeciesGrades}}"
                                          SelectedItem="{Binding SpeciesGrade, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Override" Binding="{Binding ManualOverride, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                    <DataGridTextColumn Header="E [MPa]" Binding="{Binding ElasticModulus, StringFormat=N0}" Width="80"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"/>
                    <DataGridTextColumn Header="f_m/Fb" Binding="{Binding BendingStrength, StringFormat=N2}" Width="70"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"/>
                    <DataGridTextColumn Header="f_t0/Ft" Binding="{Binding TensionStrength, StringFormat=N2}" Width="70"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"/>
                    <DataGridTextColumn Header="f_t90" Binding="{Binding TensionPerpStrength, StringFormat=N2}" Width="60"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"
                        Visibility="{Binding Data.Document.Design.Code, Source={StaticResource MatProxy}, Converter={StaticResource CodeVis}, ConverterParameter='EC5,TR'}"/>
                    <DataGridTextColumn Header="f_c0/Fc" Binding="{Binding CompressionStrength, StringFormat=N2}" Width="70"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"/>
                    <DataGridTextColumn Header="f_c90" Binding="{Binding CompressionPerpStrength, StringFormat=N2}" Width="60"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"/>
                    <DataGridTextColumn Header="f_v/Fv" Binding="{Binding ShearStrength, StringFormat=N2}" Width="70"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"/>
                    <DataGridTextColumn Header="E0,05/Emin" Binding="{Binding ModulusBuckling, StringFormat=N0}" Width="80"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"/>
                    <DataGridTextColumn Header="ρk" Binding="{Binding Density, StringFormat=N0}" Width="60"
                        ElementStyle="{StaticResource OverrideValueDisplayStyle}" EditingElementStyle="{StaticResource OverrideValueEditStyle}"
                        Visibility="{Binding Data.Document.Design.Code, Source={StaticResource MatProxy}, Converter={StaticResource CodeVis}, ConverterParameter='EC5,TR'}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="SectionsSheetTemplate">
        <GroupBox Header="Sections">
            <DataGrid ItemsSource="{Binding Document.Sections}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="36"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Width [m]" Binding="{Binding Width}" Width="*"/>
                    <DataGridTextColumn Header="Depth [m]" Binding="{Binding Depth}" Width="*"/>
                    <DataGridTextColumn Header="I [m⁴]" Binding="{Binding MomentOfInertia}" Width="*"/>
                    <DataGridTextColumn Header="A [m²]" Binding="{Binding Area}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="SupportsSheetTemplate">
        <GroupBox Header="Supports">
            <DataGrid ItemsSource="{Binding Document.Supports}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Node" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Nodes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Node, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ux" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding RestrainX, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Uy" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding RestrainY, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Rz" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding RestrainRz, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="JointLoadsSheetTemplate">
        <GroupBox Header="Joint Loads">
            <DataGrid ItemsSource="{Binding Document.NodalLoads}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Node" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Nodes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Node, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Fx" Binding="{Binding Fx}" Width="*"/>
                    <DataGridTextColumn Header="Fy" Binding="{Binding Fy}" Width="*"/>
                    <DataGridTextColumn Header="Mz" Binding="{Binding Mz}" Width="*"/>
                    <DataGridTemplateColumn Header="Nature" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource LoadNatures}}"
                                          SelectedItem="{Binding Nature, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="DistributedLoadsSheetTemplate">
        <GroupBox Header="Distributed Loads (frame only)">
            <DataGrid ItemsSource="{Binding Document.DistributedLoads}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Element" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Elements, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Element, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="w /length" Binding="{Binding MagnitudePerLength}" Width="*"/>
                    <DataGridTemplateColumn Header="Dir" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource LoadDirections}}"
                                          SelectedItem="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nature" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource LoadNatures}}"
                                          SelectedItem="{Binding Nature, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="PointLoadsSheetTemplate">
        <GroupBox Header="Point Loads (frame only)">
            <DataGrid ItemsSource="{Binding Document.PointLoads}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Element" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Elements, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Element, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Dist." Binding="{Binding DistanceFromStart}" Width="*"/>
                    <DataGridTextColumn Header="P" Binding="{Binding Magnitude}" Width="*"/>
                    <DataGridTemplateColumn Header="Dir" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource LoadDirections}}"
                                          SelectedItem="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nature" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource LoadNatures}}"
                                          SelectedItem="{Binding Nature, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="SettlementsSheetTemplate">
        <GroupBox Header="Settlements">
            <DataGrid ItemsSource="{Binding Document.Settlements}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Node" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Nodes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Node, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="dUx" Binding="{Binding DeltaUx}" Width="*"/>
                    <DataGridTextColumn Header="dUy" Binding="{Binding DeltaUy}" Width="*"/>
                    <DataGridTextColumn Header="dRz" Binding="{Binding DeltaRz}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="ThermalLoadsSheetTemplate">
        <GroupBox Header="Thermal Loads (frame only)">
            <DataGrid ItemsSource="{Binding Document.TemperatureLoads}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Element" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Document.Elements, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Element, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ΔT" Binding="{Binding UniformTemperatureChange}" Width="*"/>
                    <DataGridTextColumn Header="Grad" Binding="{Binding TemperatureGradient}" Width="*"/>
                    <DataGridTextColumn Header="α" Binding="{Binding ThermalExpansionCoefficient}" Width="*"/>
                    <DataGridTextColumn Header="Depth" Binding="{Binding MemberDepth}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="LoadCasesTemplate">
        <TextBlock Text="Load cases — coming soon (backend not ready yet)." Foreground="Gray" Margin="8" TextWrapping="Wrap"/>
    </DataTemplate>

    <DataTemplate x:Key="LoadCombinationsTemplate">
        <TextBlock Text="Load combinations — coming soon (backend not ready yet)." Foreground="Gray" Margin="8" TextWrapping="Wrap"/>
    </DataTemplate>

    <DataTemplate x:Key="ResultsSheetTemplate">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.4*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="2,2,2,6" TextWrapping="Wrap"
                       Foreground="DarkGoldenrod" FontWeight="SemiBold"
                       Visibility="{Binding ResultsAreStale, Converter={StaticResource BoolToVis}}"
                       Text="⚠ Model changed since the last run — results are out of date. Re-run analysis."/>

            <GroupBox Grid.Row="1" Header="Members">
                <ListBox MaxHeight="120" ItemsSource="{Binding Document.Elements}"
                         SelectedValuePath="Id" SelectedValue="{Binding SelectedElementId}"/>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Reactions">
                <DataGrid ItemsSource="{Binding LastOutcome.Result.Reactions}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Node" Binding="{Binding NodeId}" Width="*"/>
                        <DataGridTextColumn Header="Fx" Binding="{Binding Fx, StringFormat=N3}" Width="*"/>
                        <DataGridTextColumn Header="Fy" Binding="{Binding Fy, StringFormat=N3}" Width="*"/>
                        <DataGridTextColumn Header="Mz" Binding="{Binding Mz, StringFormat=N3}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Messages">
                <ListBox ItemsSource="{Binding LastOutcome.Messages}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="["/><Run Text="{Binding Severity}"/><Run Text="] "/><Run Text="{Binding Message}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DesignSettingsSheetTemplate">
        <GroupBox Header="Design — Project Details">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8" MaxWidth="320" HorizontalAlignment="Left">
                    <TextBlock Text="Design code" Margin="0,4,0,2"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource TimberCodes}}"
                              SelectedItem="{Binding Document.Design.Code, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- EC5 / TR: service class + load duration -->
                    <StackPanel Visibility="{Binding Document.Design.Code, Converter={StaticResource CodeVis}, ConverterParameter='EC5,TR'}">
                        <TextBlock Text="Service class (humidity exposure)" Margin="0,10,0,2"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource ServiceClasses}}"
                                  SelectedItem="{Binding Document.Design.ServiceClass, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Default load-duration class" Margin="0,10,0,2"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource LoadDurationClasses}}"
                                  SelectedItem="{Binding Document.Design.DefaultLoadDuration, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- US: moisture condition -->
                    <StackPanel Visibility="{Binding Document.Design.Code, Converter={StaticResource CodeVis}, ConverterParameter=US}">
                        <TextBlock Text="Moisture condition" Margin="0,10,0,2"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource MoistureConditions}}"
                                  SelectedItem="{Binding Document.Design.MoistureCondition, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- EC5: partial / modification factor override -->
                    <StackPanel Visibility="{Binding Document.Design.Code, Converter={StaticResource CodeVis}, ConverterParameter=EC5}">
                        <CheckBox Content="Override code-derived factors" Margin="0,12,0,2"
                                  IsChecked="{Binding Document.Design.FactorsModified, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="γ_M" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Document.Design.PartialFactor}" Margin="2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="k_mod" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Document.Design.ModificationFactor}" Margin="2"/>
                        </Grid>
                    </StackPanel>

                    <!-- US: load-duration / time-effect factors -->
                    <StackPanel Visibility="{Binding Document.Design.Code, Converter={StaticResource CodeVis}, ConverterParameter=US}">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="C_D (load duration)" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Document.Design.LoadDurationFactor}" Margin="2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="λ (time effect)" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Document.Design.TimeEffectFactor}" Margin="2"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"
                               Text="The design code lives here, not in global setup — analysis stays code-agnostic. One code per project."/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="MemberDesignSheetTemplate">
        <GroupBox Header="Member Design Parameters (one row per element; demands come from analysis)">
            <DataGrid ItemsSource="{Binding Document.MemberDesigns}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Resources>
                    <conv:BindingProxy x:Key="MdProxy" Data="{Binding}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Member" Binding="{Binding Element}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Le major [mm]" Binding="{Binding EffectiveLengthMajor}" Width="*"/>
                    <DataGridTextColumn Header="Le minor [mm]" Binding="{Binding EffectiveLengthMinor}" Width="*"/>
                    <DataGridTextColumn Header="Le beam [mm]" Binding="{Binding EffectiveBeamLength}" Width="*"/>
                    <DataGridTextColumn Header="Net/Gross" Binding="{Binding NetAreaFactor}" Width="74"/>
                    <DataGridTemplateColumn Header="Support" Width="110"
                        Visibility="{Binding Data.Document.Design.Code, Source={StaticResource MdProxy}, Converter={StaticResource CodeVis}, ConverterParameter='EC5,TR'}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource SupportTypesEU}}"
                                          SelectedItem="{Binding SupportType, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Lat. supp." Binding="{Binding IsLaterallySupported, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Repet." Binding="{Binding IsRepetitiveMember, UpdateSourceTrigger=PropertyChanged}" Width="60"
                        Visibility="{Binding Data.Document.Design.Code, Source={StaticResource MdProxy}, Converter={StaticResource CodeVis}, ConverterParameter=US}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="DesignResultsSheetTemplate">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="2,2,2,6" TextWrapping="Wrap"
                       Foreground="DarkGoldenrod" FontWeight="SemiBold"
                       Visibility="{Binding ResultsAreStale, Converter={StaticResource BoolToVis}}"
                       Text="⚠ Model changed since the last analysis — re-run analysis, then design."/>

            <GroupBox Grid.Row="1" Header="Member utilization (D/C)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LastDesignOutcome.Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,2" IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Member " FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ElementId}" FontWeight="SemiBold"/>
                                            <TextBlock Text="   D/C = "/>
                                            <TextBlock Text="{Binding GoverningUtilization, StringFormat=P0}"/>
                                            <Border Margin="8,0,0,0" CornerRadius="3" Padding="6,0"
                                                    Background="{Binding GoverningStatus, Converter={StaticResource StatusToBrush}}">
                                                <TextBlock Text="{Binding GoverningStatus}" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <DataGrid ItemsSource="{Binding Checks}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" Margin="16,2,0,6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Check" Binding="{Binding CheckType}" Width="*"/>
                                            <DataGridTextColumn Header="D/C" Binding="{Binding Utilization, StringFormat=P0}" Width="80"/>
                                            <DataGridTemplateColumn Header="Status" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Messages">
                <ListBox ItemsSource="{Binding LastDesignOutcome.Messages}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="["/><Run Text="{Binding Severity}"/><Run Text="] "/><Run Text="{Binding Message}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
