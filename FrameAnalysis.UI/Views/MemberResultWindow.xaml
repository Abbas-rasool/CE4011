<Window x:Class="FrameAnalysis.UI.MemberResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member results" Width="480" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubHeaderText" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="DeflCaption" FontSize="12" Foreground="#444444" Margin="0,8,0,2"/>
                <Border BorderBrush="#EEEEEE" BorderThickness="1">
                    <Canvas x:Name="DeflCanvas" Height="96" Background="Transparent"/>
                </Border>

                <TextBlock x:Name="AxialCaption" FontSize="12" Foreground="#444444" Margin="0,14,0,2"/>
                <Border BorderBrush="#EEEEEE" BorderThickness="1">
                    <Canvas x:Name="AxialCanvas" Height="70" Background="Transparent"/>
                </Border>

                <TextBlock x:Name="ShearCaption" FontSize="12" Foreground="#444444" Margin="0,14,0,2"/>
                <Border BorderBrush="#EEEEEE" BorderThickness="1">
                    <Canvas x:Name="ShearCanvas" Height="70" Background="Transparent"/>
                </Border>

                <TextBlock x:Name="MomentCaption" FontSize="12" Foreground="#444444" Margin="0,14,0,2"/>
                <Border BorderBrush="#EEEEEE" BorderThickness="1">
                    <Canvas x:Name="MomentCanvas" Height="84" Background="Transparent"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
